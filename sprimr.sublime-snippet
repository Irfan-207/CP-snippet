/*
Sieve to generate all primes up to a limit
Returns a vector of all prime numbers <= LIM

Usage:
    vector<int> primes = sieve(1000000);
    for (int p : primes) cout << p << " ";
*/

vector<int> sieve(int LIM)
{
    vector<char> is_prime(LIM + 1, true);

    is_prime[0] = is_prime[1] = false; // 0 and 1 are not prime

    for (int p = 2; 1LL * p * p <= LIM; ++p)
    {
        if (is_prime[p])
        {
            for (long long j = 1LL * p * p; j <= LIM; j += p)
            {
                is_prime[(int)j] = false;
            }
        }
    }

    vector<int> primes;

    for (int i = 2; i <= LIM; ++i)
    {
        if (is_prime[i]) primes.push_back(i);
    }

    return primes;
}
