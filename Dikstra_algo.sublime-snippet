    vector<bool> vis(n + 1 , false);
    set<pair<ll,ll>> st;
    st.insert({0 , start});
    dis[start] = 0;
    while(!st.empty())
    {
    	auto it = *st.begin();
    	ll node = it.second;

    	st.erase(st.begin());

    	if(vis[node]) continue;
    	vis[node] = true;

    	for(auto &x : adj[node])
    	{
    		ll child = x.first;
    		ll wt = x.second;

    		if(dis[node] + wt < dis[child])
    		{
    			dis[child] = dis[node] + wt;
    			st.insert({dis[child] , child});
    		}
    	}
    }

    if(dis[end] == INF) cout << -1 << endl;
    else cout << dis[end] << endl;
}
