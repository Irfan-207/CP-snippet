template<typename T>
vector<T> suffix_sum_generic(const vector<T>& a)
{
    int n = (int)a.size();
    vector<T> s(n);

    T cur = T();

    for (int i = n - 1; i >= 0; --i)
    {
        cur += a[i];
        s[i] = cur;
    }

    return s;
}
