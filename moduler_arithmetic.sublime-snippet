int add(int a , int b, int mod)
{
    int res = (a + b) % mod;

    if(res < 0) res += mod;

    return res;
}

int mul(int a , int b , int mod)
{
    int res = (a * 1LL * b) % mod;

    if(res < 0) res += mod;

    return res;
}

int power(int a , int b , int mod)
{
    int res = 1;

    while (b)
    {
        if (b & 1) res = mul(res, a, mod);

        a = mul(a,a,mod);
        b /= 2;
    }

    return res;
}
]]></content>
