// check if t is a subsequence of s
bool subsequence(string &s , string &t)
{
    int i = 0 , j = 0;

    int len1 = s.length();
    int len2 = t.length();

    while (i < len1 && j < len2)
    {
        if(s[i] == t[j]) j++;

        i++;
    }

    return j == len2;
}


// check if t is a subsegment (continuous substring) of s
bool subsegment(const string &s, const string &t)
{
    int n = s.size(), m = t.size();

    if (m > n) return false;

    for (int i = 0; i + m <= n; i++)
    {
        bool ok = true;

        for (int j = 0; j < m; j++)
        {
            if (s[i + j] != t[j])
            {
                ok = false;
                break;
            }
        }

        if (ok) return true;
    }

    return false;
}
