// --- helpers (gpt version)

// reduce x into [0, mod-1]
inline ll safe_mod(ll x, ll mod)
{
    if (mod == 0) return x; // undefined for mod==0, caller shouldn't use mod==0

    ll r = x % mod;

    if (r < 0) r += mod;

    return r;
}


// extended gcd: returns gcd(a,b) and finds x,y such that a*x + b*y = gcd
ll ext_gcd(ll a, ll b, ll &x, ll &y)
{
    x = 1;
    y = 0;

    ll x1 = 0, y1 = 1;

    while (b != 0)
    {
        ll q = a / b;

        ll t = a - q * b;
        a = b;
        b = t;

        t = x - q * x1;
        x = x1;
        x1 = t;

        t = y - q * y1;
        y = y1;
        y1 = t;
    }

    return a;
}


// modular inverse of a modulo m, returns -1 if inverse doesn't exist
ll mod_inv(ll a, ll m)
{
    a = safe_mod(a, m);

    ll x, y;
    ll g = ext_gcd(a, m, x, y);

    if (g != 1) return -1;

    x %= m;

    if (x < 0) x += m;

    return x;
}


// --- core functions -------------------------------------------------------


// Safe multiplication: (a * b) % mod using __int128
// Works for signed a,b. mod > 0 expected. Returns value in [0, mod-1].
ll bin_multiply(ll a, ll b, ll mod)
{
    if (mod == 1) return 0;

    __int128_t prod = (__int128_t)a * (__int128_t)b;

    ll r = (ll)(prod % mod);

    if (r < 0) r += mod;

    return r;
}


// Binary exponentiation (integer power). Only for non-negative exponents.
// If b < 0, this function does NOT compute rational results (not defined here).
// If you need negative exponents in integer arithmetic, use modular exponentiation
// with modular inverse instead.
ll Bin_Exp(ll a, unsigned long long b)
{
    __int128_t res = 1;
    __int128_t base = a;

    while (b > 0)
    {
        if (b & 1) res *= base;

        base *= base;
        b >>= 1;
    }

    return (ll)res; // caller must ensure result fits in ll
}


// Binary exponentiation modulo mod: computes (a^b) % mod safely.
// - accepts signed base `a`
// - accepts signed exponent `b`: if b >= 0 -> computes a^b % mod
//                           if b < 0  -> computes modular inverse(a)^(-b) % mod
//                                     (returns -1 if inverse doesn't exist)
// - returns value in [0, mod-1] on success, or -1 if impossible (inverse missing)
ll BinExp_mod(ll a, long long b, ll mod)
{
    if (mod == 1) return 0;

    a = safe_mod(a, mod);

    // handle negative exponent using modular inverse
    if (b < 0)
    {
        ll inv = mod_inv(a, mod);

        if (inv == -1) return -1;

        a = inv;

        // careful: -b might overflow if b == LLONG_MIN; convert to unsigned
        unsigned long long eb = (unsigned long long)(-(b + 1)) + 1ULL;

        // now compute a^eb % mod
        ll res = 1 % mod;

        while (eb > 0)
        {
            if (eb & 1ULL) res = bin_multiply(res, a, mod);

            a = bin_multiply(a, a, mod);
            eb >>= 1ULL;
        }

        return res;
    }

    // b >= 0
    unsigned long long eb = (unsigned long long)b;

    ll res = 1 % mod;

    while (eb > 0)
    {
        if (eb & 1ULL) res = bin_multiply(res, a, mod);

        a = bin_multiply(a, a, mod);
        eb >>= 1ULL;
    }

    return res;
}


// Euler's Totient Function phi(n). phi(0) undefined; phi(1) = 1.
ll ETF(ll n)
{
    if (n <= 1) return 1;

    ll result = n;

    for (ll p = 2; p * p <= n; ++p)
    {
        if (n % p == 0)
        {
            while (n % p == 0) n /= p;

            result -= result / p;
        }
    }

    if (n > 1) result -= result / n;

    return result;
}


// Euler modular exponentiation: computes (a^b) % MOD, but uses Euler reduction
// to reduce exponent when b is large. Works for:
// - positive b (reduction by phi(MOD))
// - negative b (uses modular inverse if it exists)
// Returns value in [0,MOD-1] on success, or -1 when a modular inverse is required but doesn't exist.
//
// Notes:
// - If MOD==1, returns 0.
// - If a % MOD == 0 and b > 0, returns 0 quickly.
// - Reduction: if b >= phi(MOD) then use b % phi + phi (safe also when gcd(a,MOD) != 1).
ll EulerModExp(ll a, long long b, ll MOD)
{
    if (MOD == 1) return 0;

    a = safe_mod(a, MOD);

    if (b == 0) return 1 % MOD;

    if (a == 0)
    {
        // 0^positive = 0, 0^0 handled above as 1
        if (b > 0) return 0;

        // b < 0 -> inverse does not exist
        return -1;
    }

    if (b < 0)
    {
        // need modular inverse then positive exponent
        ll inv = mod_inv(a, MOD);

        if (inv == -1) return -1;

        return EulerModExp(inv, -b, MOD);
    }

    // b > 0
    // compute phi (costly if MOD is large and not factorable quickly)
    ll phi = ETF(MOD);

    // effective exponent: if b >= phi use (b % phi) + phi to be safe for non-coprime case
    unsigned long long effective;

    if (b >= phi)
    {
        effective = (unsigned long long)(b % phi) + (unsigned long long)phi;
    }
    else
    {
        effective = (unsigned long long)b;
    }

    return BinExp_mod(a, (long long)effective, MOD);
}
